# ========================================
# CONFIGURACIÓN SKYSCANNER BOT - DOCKER
# ========================================

# === CREDENCIALES (OBLIGATORIO) ===
SKYSCANNER_API_KEY=
# Path dentro del contenedor (montado via docker-compose volume)
GOOGLE_KEYFILE=


# === GOOGLE SHEETS URLs (OBLIGATORIO) ===
SHEET_ORIGEN_URL=
SHEET_DESTINO_URL=

# === CONFIGURACIÓN DE ARCHIVOS (paths Docker) ===
SS_ENTITY_CACHE=
SS_LOCKFILE=
SS_LOG_FILE=

# === CONFIGURACIÓN DE RATE LIMITING ===
SS_MAX_CALLS_PER_MIN=
SS_RATE_LIMIT_WINDOW=

# === CONFIGURACIÓN DE POLLING (PRECISIÓN) ===
SS_MIN_GUARANTEED_POLLS=
SS_MAX_POLL_ROUNDS=
SS_POLL_SLEEP_SECONDS=
SS_POLL_DEADLINE_SECONDS=
SS_WAIT_FOR_COMPLETE=

# === CONFIGURACIÓN DE VUELOS ===
ADULTOS=
CHILDREN=
CABIN=
MARKET=
LOCALE=
CURRENCY=

# === CONFIGURACIÓN TÉCNICA ===
USE_ENTITY_ID=
WRITE_IMMEDIATELY=
FORCE_BEST_TO_CHEAPEST=

# === CONFIGURACIÓN DE HOJAS ===
ORIGENES_FILAS=
EXTRAS_COL=

# === CONFIGURACIÓN DE MULTI-HOJA ===
PRIORIDAD_PROCESO=
SOLO_UNA_ACTIVA=
POLITICA_MULTIPLE=

# === CONFIGURACIÓN DE LOGGING ===
SS_LOG_LEVEL=

# === CONFIGURACIÓN DE HOJAS (CELDAS) ===
# V1
V1_CAPTURA_SHEET=
V1_RESULTADO_SHEET=
V1_SWITCH_CELL=
V1_OFF_SWITCH_CELL=
V1_STATS_CELL=
V1_ORIGEN_CELL=
V1_DESTINO_CELL=

# V2
V2_CAPTURA_SHEET=
V2_RESULTADO_SHEET=
V2_SWITCH_CELL=
V2_OFF_SWITCH_CELL=
V2_STATS_CELL=
V2_ORIGEN_CELL=
V2_DESTINO_CELL=

# V3
V3_CAPTURA_SHEET=
V3_RESULTADO_SHEET=
V3_SWITCH_CELL=
V3_OFF_SWITCH_CELL=
V3_STATS_CELL=
V3_ORIGEN_CELL=
V3_DESTINO_CELL=

# ========================================
# PUEBLA B (en Vuelos V6.1)
# ========================================
PUEBLA_CAPTURA_SHEET=
PUEBLA_RESULTADO_SHEET=
# Switch externo: botones ON/OFF en hoja "Administración VALV" → pestaña "V6 Vuelos"
PUEBLA_SWITCH_URL=
PUEBLA_SWITCH_SHEET=
PUEBLA_SWITCH_CELL=
PUEBLA_OFF_SWITCH_CELL=
PUEBLA_STATS_CELL=
PUEBLA_ORIGEN_CELL=
PUEBLA_DESTINO_CELL=
PUEBLA_ORIGEN_URL=
PUEBLA_SOLO_EXTRAS=
PUEBLA_EXTRAS_FILAS=
PUEBLA_EXTRAS_COL=
PUEBLA_EXTRAS_LIMIT_COL=
PUEBLA_EXTRAS_CHECK_COL=

# ========================================
# JALISCO B (en Vuelos V6.1)
# ========================================
JALISCO_CAPTURA_SHEET=
JALISCO_RESULTADO_SHEET=
# Switch externo: botón ON en hoja "Administración VALV" → pestaña "V6 Vuelos"
JALISCO_SWITCH_URL=
JALISCO_SWITCH_SHEET=
JALISCO_SWITCH_CELL=
JALISCO_OFF_SWITCH_CELL=
JALISCO_STATS_CELL=
JALISCO_ORIGEN_CELL=
JALISCO_DESTINO_CELL=
JALISCO_ORIGEN_URL=
JALISCO_SOLO_EXTRAS=
JALISCO_EXTRAS_FILAS=
JALISCO_EXTRAS_COL=
JALISCO_EXTRAS_LIMIT_COL=
JALISCO_EXTRAS_CHECK_COL=

# ========================================
# EDOMEX B (en Vuelos V6.1)
# ========================================
EDOMEX_CAPTURA_SHEET=
EDOMEX_RESULTADO_SHEET=
# Switch externo: botón ON en hoja "Administración VALV" → pestaña "V6 Vuelos"
EDOMEX_SWITCH_URL=
EDOMEX_SWITCH_SHEET=
EDOMEX_SWITCH_CELL=
EDOMEX_OFF_SWITCH_CELL=
EDOMEX_STATS_CELL=
EDOMEX_ORIGEN_CELL=
EDOMEX_DESTINO_CELL=
EDOMEX_ORIGEN_URL=
EDOMEX_SOLO_EXTRAS=
EDOMEX_EXTRAS_FILAS=
EDOMEX_EXTRAS_COL=
EDOMEX_EXTRAS_LIMIT_COL=
EDOMEX_EXTRAS_CHECK_COL=

# ========================================
# YUCATAN B (en Vuelos V6.1)
# ========================================
YUCATAN_CAPTURA_SHEET=
YUCATAN_RESULTADO_SHEET=
# Switch externo: botón ON en hoja "Administración VALV" → pestaña "V6 Vuelos"
YUCATAN_SWITCH_URL=
YUCATAN_SWITCH_SHEET=
YUCATAN_SWITCH_CELL=
YUCATAN_OFF_SWITCH_CELL=
YUCATAN_STATS_CELL=
YUCATAN_ORIGEN_CELL=
YUCATAN_DESTINO_CELL=
YUCATAN_ORIGEN_URL=
YUCATAN_SOLO_EXTRAS=
YUCATAN_EXTRAS_FILAS=
YUCATAN_EXTRAS_COL=
YUCATAN_EXTRAS_LIMIT_COL=
YUCATAN_EXTRAS_CHECK_COL=

# === WATCHTOWER (Docker Hub credentials para auto-update) ===
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Cada cuanto se revisa el switch ON (antes 300 = 5 min)
LOOP_INTERVAL_SECONDS=

SHEETS_CHECK_DELAY=

PAUSE_BETWEEN_SHEETS=

# Busquedas Skyscanner simultaneas por bot (subir midiendo 429)
SS_PARALLEL_SEARCHES=

# Filas por request de escritura a Sheets (1 = fila por fila)
SS_WRITE_BATCH_SIZE=

# Solo vuelos DIRECTOS para cheapest y best (como el filtro "Directo" de la web). Sin directos -> fila omitida
SS_SOLO_DIRECTOS=
SS_SIN_DIRECTO_USAR_ESCALAS=

# ===== TRIÁNGULO JAZ (multi-city: tramo1 E2->F2 en fecha IDA, tramo2 G2->H2 en fecha VUELTA) =====
TRIJAZ_TIPO=
TRIJAZ_ORIGEN_URL=
TRIJAZ_CAPTURA_SHEET=
TRIJAZ_RESULTADO_SHEET=
TRIJAZ_SWITCH_CELL=
TRIJAZ_OFF_SWITCH_CELL=
TRIJAZ_STATS_CELL=
TRIJAZ_LEG1_ORIGEN_CELL=
TRIJAZ_LEG1_DESTINO_CELL=
TRIJAZ_LEG2_ORIGEN_CELL=
TRIJAZ_LEG2_DESTINO_CELL=
TRIJAZ_PERSONAS_CELL=
TRIJAZ_CABINA_CELL=
TRIJAZ_MERCADO_CELL=
TRIJAZ_MONEDA_CELL=
TRIJAZ_DIRECTO_CELL=
TRIJAZ_LIMITE_CELL=
TRIJAZ_MODO_CELL=
TRIJAZ_PRECIO_COL=
TRIJAZ_PRECIO_FECHA_COL=
TRIJAZ_PRECIO_FILA_INICIO=
TRIJAZ_PRECIO_FILA_FIN=

# ===== VUELO IDA (sencillo: un tramo E2->F2 en la fecha IDA; la columna VUELTA se ignora) =====
VUEIDA_TIPO=
VUEIDA_ORIGEN_URL=
VUEIDA_CAPTURA_SHEET=
VUEIDA_RESULTADO_SHEET=
VUEIDA_SWITCH_CELL=
VUEIDA_OFF_SWITCH_CELL=
VUEIDA_STATS_CELL=
VUEIDA_LEG1_ORIGEN_CELL=
VUEIDA_LEG1_DESTINO_CELL=
